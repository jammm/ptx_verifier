    "s_load_b64 s[2:3], s[0:1], 0x0",
    "s_mov_b32 sN, <canary literal>   (N in s4..s15, not named by the body)",
    "v_mov_b32 vN, <canary literal>   (N in VGPR pool, not named by the body)",
    "s_wait_alu 0x0",
    "v_and_b32 v1, 0x3ff, v0",
    "v_lshlrev_b32 v1, 2, v1",
    "v_mov_b32 vT, sN   (vT = OUT_TEMPS[k], v10..v17; k = store slot index)",
