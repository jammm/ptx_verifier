{
  "id": "litmus-b0-t2",
  "version": 1,
  "family": "litmus",
  "target": "gfx1250",
  "stepping": "B0 (rocminfo ASIC Revision != 0)",
  "dependency_profile": "gfx1250-b0-sched0-litmus/2",
  "verifier_profile": "gfx1250-b0-litmus/2",
  "contract": "tests/gfx1250/CONTRACT.md (litmus profiles)",
  "templates": [
    "asynclds",
    "barjoin",
    "bufload",
    "bufstore"
  ],
  "regions": {
    "bufload": {
      "nr": {
        "min": 1,
        "why": "num_records 0 is an unbound resource whose behaviour is not specified"
      }
    },
    "bufstore": {
      "nr": {
        "min": 1,
        "why": "num_records 0 is an unbound resource whose behaviour is not specified"
      }
    },
    "asynclds": {
      "ioff": {
        "max": 65535,
        "why": "instruction offsets >= 64 KiB are outside the profile; an offset that is not a multiple of the width leaves the LDS footprint unaligned, whose address depends on the alignment mode (not a launch premise)",
        "multiple_of": "width"
      }
    },
    "barjoin": {
      "wait_first": {
        "min": 1,
        "why": "without a wait on A, the completion report of A may still be outstanding at the next JOIN; the specified behaviour does not order the two, so STATE_PRIV[3] is not settled (join without a wait on A)"
      }
    }
  },
  "template_controls": {
    "asynclds": [
      "asynclds_lo"
    ],
    "bufload": [
      "bufload_exact_end",
      "bufload_inrange"
    ],
    "bufstore": [
      "bufstore_inrange",
      "bufstore_oob1_stride"
    ],
    "barjoin": [
      "barjoin_wait_cured",
      "barjoin_wait_gap0"
    ]
  },
  "litmus_controls": [
    "bufload_inrange",
    "bufload_exact_end",
    "bufload_partial_b128",
    "bufstore_inrange",
    "bufstore_oob1_nr4",
    "bufstore_oob1_stride",
    "asynclds_lo",
    "barjoin_wait_gap0",
    "barjoin_wait_cured"
  ],
  "unsupported_templates": {
    "asyncstore": "visibility of an async store to the wave's own later load is not specified, for the candidate and the twin",
    "bufswz": "data layout depends on the allocation address mod 2 KiB, which neither the launcher nor its documented API fixes; outside the profile"
  },
  "body_allowed_ops": [
    "buffer_load_b128",
    "buffer_load_b32",
    "buffer_load_b64",
    "buffer_load_b96",
    "buffer_store_b128",
    "buffer_store_b32",
    "buffer_store_b64",
    "buffer_store_b96",
    "ds_load_b32",
    "ds_store_b32",
    "global_load_async_to_lds_b128",
    "global_load_async_to_lds_b32",
    "global_load_async_to_lds_b64",
    "global_store_b128",
    "global_store_b32",
    "s_add_nc_u64",
    "s_and_b32",
    "s_barrier_init",
    "s_barrier_join",
    "s_barrier_signal",
    "s_barrier_wait",
    "s_cbranch_scc1",
    "s_cmp_lg_u32",
    "s_getreg_b32",
    "s_mov_b32",
    "s_nop",
    "s_or_b32",
    "s_wait_alu",
    "s_wait_asynccnt",
    "s_wait_dscnt",
    "s_wait_idle",
    "s_wait_loadcnt",
    "s_wait_storecnt",
    "v_add_nc_u32",
    "v_cmp_eq_u32",
    "v_cndmask_b32",
    "v_lshl_add_u32",
    "v_lshlrev_b32",
    "v_mov_b32",
    "v_or_b32",
    "v_readfirstlane_b32"
  ],
  "pending_ops": [],
  "wrapper_mnemonics": [
    "global_prefetch_b8",
    "s_endpgm",
    "s_load_b64",
    "s_mov_b64",
    "s_wait_kmcnt",
    "v_nop"
  ],
  "control_only_ops": [],
  "allowlist_canonical": "sha256 of json.dumps({'body','pending','wrapper','control_only'} sorted lists, separators=(',',':'), sort_keys=True)",
  "allowlist_sha256": "d1d877a297c3fc20af348270bf3d13446d093fcccd65e2e515e28d57909cae7b"
}
