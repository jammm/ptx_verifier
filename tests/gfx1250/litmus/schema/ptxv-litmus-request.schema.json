{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "ptxv-litmus-request/1",
 "title": "ptx_verifier litmus pre-execution check request (one fuzzer litmus kernel: candidate or twin)",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schema",
  "profile",
  "role",
  "kernel",
  "source",
  "object",
  "launch_file",
  "backing_allocation",
  "guards",
  "objects",
  "lds_bytes",
  "outputs"
 ],
 "properties": {
  "schema": {
   "const": "ptxv-litmus-request/1"
  },
  "profile": {
   "const": "gfx1250-b0-litmus/1"
  },
  "role": {
   "enum": [
    "cand",
    "twin",
    "control"
   ]
  },
  "kernel": {
   "const": "kernel"
  },
  "source": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "path",
    "sha256"
   ],
   "properties": {
    "path": {
     "type": "string"
    },
    "sha256": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    }
   }
  },
  "object": {
   "description": "Audited code object built from the same source by the fuzzer toolchain. Recorded and echoed; the verifier analyzes the source text and checks the source hash only.",
   "type": "object",
   "additionalProperties": false,
   "required": [
    "sha256"
   ],
   "properties": {
    "path": {
     "type": "string"
    },
    "sha256": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    }
   }
  },
  "launch_file": {
   "description": "Launch premises of the litmus profile: one wave32 workgroup; the kernarg pointer is the first object.",
   "type": "object",
   "additionalProperties": false,
   "required": [
    "block",
    "grid",
    "kernel",
    "params",
    "max_instructions"
   ],
   "properties": {
    "block": {
     "const": [
      32,
      1,
      1
     ]
    },
    "grid": {
     "const": [
      1,
      1,
      1
     ]
    },
    "workgroup_id": {
     "const": [
      0,
      0,
      0
     ]
    },
    "kernel": {
     "const": "kernel"
    },
    "max_instructions": {
     "type": "integer",
     "minimum": 1,
     "maximum": 200000
    },
    "params": {
     "type": "array",
     "minItems": 1,
     "maxItems": 1,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "ptr"
      ],
      "properties": {
       "ptr": {
        "enum": [
         "out",
         "data"
        ]
       }
      }
     }
    }
   }
  },
  "backing_allocation": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "base",
    "bytes"
   ],
   "properties": {
    "base": {
     "type": "string",
     "pattern": "^0x[0-9a-f]+$"
    },
    "bytes": {
     "type": "integer",
     "minimum": 1
    }
   }
  },
  "guards": {
   "description": "Forbidden regions inside the backing allocation. Any access is a REJECT witness GUARD_ACCESS.",
   "type": "array",
   "minItems": 2,
   "maxItems": 2,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "name",
     "base",
     "bytes",
     "fill_u32"
    ],
    "properties": {
     "name": {
      "enum": [
       "pre",
       "post"
      ]
     },
     "base": {
      "type": "string",
      "pattern": "^0x[0-9a-f]+$"
     },
     "bytes": {
      "type": "integer",
      "minimum": 0
     },
     "fill_u32": {
      "const": "0xffffffff"
     }
    }
   }
  },
  "outputs": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "contract",
    "objects",
    "words"
   ],
   "properties": {
    "contract": {
     "const": "raw-u32-image"
    },
    "objects": {
     "type": "array",
     "items": {
      "enum": [
       "out",
       "data"
      ]
     }
    },
    "words": {
     "type": "integer",
     "minimum": 1
    }
   }
  },
  "template": {
   "type": "string",
   "description": "litmus template name (recorded only)"
  },
  "objects": {
   "description": "Contiguous logical objects of the region in request (output) order, with the exact words the launcher writes before the kernel runs.",
   "type": "array",
   "minItems": 1,
   "maxItems": 4,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "name",
     "base",
     "words",
     "initial"
    ],
    "properties": {
     "name": {
      "enum": [
       "out",
       "data"
      ]
     },
     "base": {
      "type": "string",
      "pattern": "^0x[0-9a-f]+$"
     },
     "words": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65536
     },
     "initial": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
       "fill_u32": {
        "type": "string",
        "pattern": "^0x[0-9a-f]+$"
       },
       "index_base_u32": {
        "type": "string",
        "pattern": "^0x[0-9a-f]+$"
       }
      }
     }
    }
   }
  },
  "lds_bytes": {
   "type": "integer",
   "minimum": 0,
   "maximum": 327680,
   "description": "static LDS bytes; must equal the descriptor group_segment_fixed_size"
  }
 }
}
